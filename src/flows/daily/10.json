{
    "header_text": "Daily Survey",
    "header_icon": "assets/subtitle.png",
    "elements": [
        {
            "type": "Text",
            "text": "Was there an issue with the device or a negative side effect that made you stop early?"
        },
        {
            "type": "Buttons",
            "buttons": [
                "Yes",
                "No"
            ],
            "selectable": true,
            "variable_name": "device_stopped_early",
            "output_name": "daily_device_stopped_early"
        }
    ],
    "condition": [
        "device_minutes",
        "<",
        40
    ]
}
