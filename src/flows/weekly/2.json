{
    "header_text": "Weekly Survey",
    "header_icon": "assets/subtitle.png",
    "elements": [
        {
            "type": "Text",
            "text": "Over the past week, you reported not using any drugs, is this correct?"
        },
        {
            "type": "Buttons",
            "buttons": [
                "Yes",
                "No"
            ],
            "selectable": true,
            "variable_name": "no_use_drugs_weekly",
            "output_name": "weekly_no_use_drugs"
        }
    ],
    "condition": [
        "historical:daily_past_week_used|7",
        "all",
        "None"
    ]
}
