{
    "header_text": "Weekly Survey",
    "header_icon": "assets/subtitle.png",
    "elements": [
        {
            "type": "Text",
            "text": "Over the past 7 days, have you used any of the following substances (not including prescribed buprenorphine)?"
        },
        {
            "type": "Buttons",
            "buttons": [
                "Prescription Opioids",
                "Heroin",
                "Fentanyl",
                "Methamphetamine",
                "Cocaine",
                "Benzodiazepines",
                "Marijuana",
                "Alcohol",
                "“Gas-station” drugs",
                "!Other",
                "^None"
            ],
            "selectable": true,
            "multiselect": true,
            "column_count": 2,
            "output_name": "weekly_past_week_used"
        }
    ],
    "condition": [
        "no_use_drugs_weekly",
        "in",
        ["no_use_drugs_weekly"],
        "&&",
        "weekly_used_days",
        "in",
        ["weekly_used_days"]
    ]
}
